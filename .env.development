# FastAPI Configuration
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=dev_secret_key_do_not_use_in_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=1440

# Database Configuration (Local or Test DB)
DATABASE_URL=sqlite:///./safechat.db

# Firebase Configuration
FIREBASE_CREDENTIALS_PATH=backend/serviceAccountKey.json

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,*

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=5
